# Local backend port
PORT=5000

# Frontend origin allowed to send cookie-based requests to the API
CLIENT_URL=http://localhost:5173

# Deployed frontend values usually look like:
# CLIENT_URL=https://your-frontend.vercel.app

# Use "development" locally and "production" when deployed
NODE_ENV=development

# MongoDB connection string
MONGO_URI=your_mongodb_connection_string

# A long random secret used to sign JWT auth cookies
JWT_SECRET=your_generated_secret

# Optional shared quota for authenticated message sends. Use rediss:// for a TLS endpoint.
# REDIS_URL=redis://localhost:6379
# MESSAGE_QUOTA_LIMIT=10
# MESSAGE_QUOTA_WINDOW_MS=10000
