{
  "name": "chat",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "smoke": "node scripts/release-smoke.mjs",
    "audit:prod": "npm audit --omit=dev",
    "check:backend": "node scripts/check-backend.mjs",
    "test:backend": "node --test --test-concurrency=1 tests/backend.integration.test.js",
    "test:socket": "node --test --test-concurrency=1 tests/socket.realtime.test.js",
    "test": "npm run test:backend && npm run test:socket",
    "verify": "npm run audit:prod && npm run check:backend && npm run test && npm --prefix frontend run lint && npm --prefix frontend run build"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.17.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.11",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  }
}
