# Local backend URLs used by Vite during development
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SOCKET_SERVER_URL=http://localhost:5000

# Deployed frontend values usually point to the hosted backend:
# These must be set in production. The frontend no longer falls back to localhost on deployed hosts.
# VITE_API_BASE_URL=https://your-backend-host.com/api
# VITE_SOCKET_SERVER_URL=https://your-backend-host.com
